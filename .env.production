# Firebase web config for production builds (used by CI deploy and any local
# `npm run build`). These values are PUBLIC by design — a Firebase web API key
# identifies the project; it is not a secret. Security is enforced by database
# rules + Cloud Functions, not by hiding these. See CLAUDE.md §4 and DEPLOY.md.
# Local dev still uses the gitignored .env.local.
#
# NOTE: Vite gives this file priority over .env.local for production builds, so
# it decides what every deployed bundle talks to. It must stay on twoagreeapp —
# the old aligned-9f843 project is DEAD.
VITE_FIREBASE_API_KEY=AIzaSyCIlrno2sY3TbFtrF0AC5lEH8bUyfOV8t8
# Auth handler domain.
#
# This was set to twoagree.app on 20 Jul so Google's sign-in screen would read
# "twoagree.app" instead of "twoagreeapp.firebaseapp.com". That broke Google
# sign-in outright: "Error 400: redirect_uri_mismatch". Listing the domain under
# Firebase console > Authentication > Settings > Authorized domains is NOT the
# same registry Google checks. With a custom authDomain the OAuth handler moves
# to https://twoagree.app/__/auth/handler, and that exact URI has to be listed
# on the OAuth client itself.
#
# TO GO BACK TO THE NICER DOMAIN (2 minutes, and worth doing):
#   Google Cloud console > project twoagreeapp > APIs & Services > Credentials
#   > the "Web client (auto created by Google Service)" OAuth 2.0 Client ID
#     Authorised JavaScript origins:  add  https://twoagree.app
#     Authorised redirect URIs:       add  https://twoagree.app/__/auth/handler
#   Then set this back to twoagree.app and push. Allow a few minutes for Google
#   to propagate the change before testing.
VITE_FIREBASE_AUTH_DOMAIN=twoagreeapp.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://twoagreeapp-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=twoagreeapp
VITE_FIREBASE_STORAGE_BUCKET=twoagreeapp.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=220230233383
VITE_FIREBASE_APP_ID=1:220230233383:web:b1b33c05f15d43c8380d02

# The Path is live. Set to false to hide the tab again.
VITE_PATH_ENABLED=true
